<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiLibreria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiLibreria.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <!-- Menú lateral -->
        <nav class="d-flex flex-column bg-light p-3" style="width: 250px; height: 100vh; position: fixed;">
            <a class="navbar-brand mb-3" asp-area="" asp-controller="Home" asp-action="Index">MiLibreria</a>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Inicio
                    </a>
                </li>

                <!-- Libros -->
                <li class="nav-item">
                    <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="collapse" data-bs-target="#librosSubmenu" aria-expanded="false">
                        <i class="bi bi-book"></i> Libros
                    </a>
                    <div class="collapse" id="librosSubmenu">
                        <ul class="nav flex-column ms-3">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Libros" asp-action="Index">
                                    <i class="bi bi-list"></i> Lista de Libros
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Libros" asp-action="Reporte">
                                    <i class="bi bi-file-earmark-text"></i> Reporte Libros
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Clientes -->
                <li class="nav-item">
                    <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="collapse" data-bs-target="#clientesSubmenu" aria-expanded="false">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                    <div class="collapse" id="clientesSubmenu">
                        <ul class="nav flex-column ms-3">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Clientes" asp-action="Index">
                                    <i class="bi bi-list"></i> Lista de Clientes
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Proveedores -->
                <li class="nav-item">
                    <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="collapse" data-bs-target="#proveedoresSubmenu" aria-expanded="false">
                        <i class="bi bi-truck"></i> Proveedores
                    </a>
                    <div class="collapse" id="proveedoresSubmenu">
                        <ul class="nav flex-column ms-3">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Proveedores" asp-action="Index">
                                    <i class="bi bi-list"></i> Lista de Proveedores
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Ventas -->
                <li class="nav-item">
                    <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="collapse" data-bs-target="#ventasSubmenu" aria-expanded="false">
                        <i class="bi bi-cash-stack"></i> Ventas
                    </a>
                    <div class="collapse" id="ventasSubmenu">
                        <ul class="nav flex-column ms-3">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Ventas" asp-action="Create">
                                    <i class="bi bi-plus-circle"></i> Nueva Venta
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Ventas" asp-action="Consultar">
                                    <i class="bi bi-search"></i> Consultar Venta
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Ventas" asp-action="Reporte">
                                    <i class="bi bi-file-earmark-text"></i> Reporte Ventas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Graficas" asp-action="Index">
                                    <i class="bi bi-bar-chart"></i> Gráficas
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Administración (Solo para administradores) -->
                @if (User.IsInRole("1"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="collapse" data-bs-target="#adminSubmenu" aria-expanded="false">
                            <i class="bi bi-gear"></i> Administración
                        </a>
                        <div class="collapse" id="adminSubmenu">
                            <ul class="nav flex-column ms-3">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Usuarios" asp-action="Index">
                                        <i class="bi bi-people"></i> Gestión de Usuarios
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                }

                <!-- Mi Perfil (Para todos los usuarios autenticados) -->
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Perfil" asp-action="Edit">
                            <i class="bi bi-person-lines-fill"></i> Mi Perfil
                        </a>
                    </li>
                }

                <!-- Sección de Login/Logout -->
                <div class="mt-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                    <li class="nav-item mb-2">
                        <span class="nav-link text-success">
                            <i class="bi bi-person-circle"></i>
                            @User.Identity.Name
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger" asp-controller="Acceso" asp-action="Salir">
                            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-primary" asp-controller="Acceso" asp-action="Index">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                        </a>
                    </li>
                }
    </div>
    </ul>
    </nav>

    <!-- Contenido principal -->
    <div class="flex-grow-1 p-4" style="margin-left: 250px;">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - MiLibreria - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>