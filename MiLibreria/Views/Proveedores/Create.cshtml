@model MiLibreria.Models.Proveedor

@{
    ViewData["Title"] = "Adicionar proveedor";
}

<h1>Adicionar proveedor</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ProveedorId" class="control-label">ID Proveedor</label>
                <input asp-for="ProveedorId" class="form-control" />
                <span asp-validation-for="ProveedorId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RUC" class="control-label">RUC</label>
                <input asp-for="RUC" class="form-control" placeholder="Ingrese RUC del proveedor" />
                <span asp-validation-for="RUC" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PersonaContacto" class="control-label">Persona de Contacto</label>
                <input asp-for="PersonaContacto" class="form-control" placeholder="Ingrese nombre del contacto" />
                <span asp-validation-for="PersonaContacto" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Direccion" class="control-label">Dirección</label>
                <input asp-for="Direccion" class="form-control" placeholder="Ingrese dirección completa" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Telefono" class="control-label">Teléfono</label>
                <input asp-for="Telefono" class="form-control" placeholder="Ingrese número telefónico" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Correo Electrónico</label>
                <input asp-for="Email" class="form-control" placeholder="correo@empresa.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Crear Proveedor
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver a la lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}