@model MiLibreria.Models.RestablecerPasswordViewModel

@{
    ViewData["Title"] = "Nueva Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3><i class="bi bi-shield-lock"></i> Nueva Contraseña</h3>
                </div>
                <div class="card-body">

                    @if (TempData["MensajeExito"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["MensajeExito"]
                        </div>
                    }

                    @if (ViewBag.CodigoGenerado != null)
                    {
                        <div class="alert alert-info">
                            <h5><i class="bi bi-info-circle"></i> Código generado para pruebas:</h5>
                            <div class="alert alert-light">
                                <strong>@ViewBag.CodigoGenerado</strong>
                            </div>
                            <small class="text-muted">En un sistema real, este código sería enviado por email.</small>
                        </div>
                    }

                    <form asp-action="RestablecerPassword" method="post" id="restablecerForm">
                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">Correo Electrónico</label>
                            <input asp-for="Correo" class="form-control"
                                   value="@ViewBag.CorreoUsuario"
                                   readonly="readonly" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CodigoVerificacion" class="form-label">Código de Verificación</label>
                            <div class="input-group">
                                <input asp-for="CodigoVerificacion" class="form-control" id="codigoInput" />
                                <button type="button" class="btn btn-outline-secondary" onclick="verificarCodigo()">
                                    <i class="bi bi-check-circle"></i> Verificar
                                </button>
                            </div>
                            <span asp-validation-for="CodigoVerificacion" class="text-danger"></span>
                            <div id="codigoMensaje" class="mt-2"></div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevaClave" class="form-label">Nueva Contraseña</label>
                            <input asp-for="NuevaClave" type="password" class="form-control" id="nuevaClave" disabled />
                            <div class="form-text">
                                <small>Mínimo 6 caracteres</small>
                            </div>
                            <span asp-validation-for="NuevaClave" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarClave" class="form-label">Confirmar Contraseña</label>
                            <input asp-for="ConfirmarClave" type="password" class="form-control" disabled />
                            <span asp-validation-for="ConfirmarClave" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                                <i class="bi bi-check-lg"></i> Restablecer Contraseña
                            </button>
                            <a asp-action="SolicitarRestablecimiento" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver atrás
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verificarCodigo() {
            var correo = document.querySelector('input[name="Correo"]').value;
            var codigo = document.getElementById('codigoInput').value;
            var mensajeDiv = document.getElementById('codigoMensaje');
            var submitBtn = document.getElementById('submitBtn');
            var nuevaClave = document.getElementById('nuevaClave');
            var confirmarClave = document.querySelector('input[name="ConfirmarClave"]');

            if (!codigo) {
                mensajeDiv.innerHTML = '<div class="alert alert-warning">Ingresa el código de verificación</div>';
                return;
            }

            // AJAX para verificar código
            fetch('/Acceso/VerificarCodigo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `correo=${encodeURIComponent(correo)}&codigo=${encodeURIComponent(codigo)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.valido) {
                    mensajeDiv.innerHTML = '<div class="alert alert-success">✓ Código verificado correctamente</div>';
                    submitBtn.disabled = false;
                    nuevaClave.disabled = false;
                    confirmarClave.disabled = false;
                } else {
                    mensajeDiv.innerHTML = '<div class="alert alert-danger">✗ ' + data.mensaje + '</div>';
                    submitBtn.disabled = true;
                    nuevaClave.disabled = true;
                    confirmarClave.disabled = true;
                }
            })
            .catch(error => {
                mensajeDiv.innerHTML = '<div class="alert alert-danger">Error al verificar el código</div>';
            });
        }

        // Verificar automáticamente cuando se escribe el código completo (6 dígitos)
        document.getElementById('codigoInput').addEventListener('input', function() {
            if (this.value.length === 6) {
                setTimeout(verificarCodigo, 500);
            }
        });
    </script>
}