@model MiLibreria.Models.SolicitarCodigoViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3><i class="bi bi-key"></i> Restablecer Contraseña</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted">Ingresa tu correo electrónico para recibir un código de verificación.</p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-action="SolicitarRestablecimiento" method="post">
                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">Correo Electrónico</label>
                            <input asp-for="Correo" class="form-control" required />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-send"></i> Enviar Código de Verificación
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver al Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>